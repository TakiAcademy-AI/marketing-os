{
  "manifest_version": 3,
  "name": "FB Ads → Marketing OS",
  "version": "1.1.0",
  "description": "Quét Facebook Ads Library + timeline Page (chạy ngầm theo lịch) và đẩy về Marketing OS.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Ads → Marketing OS"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/ads/library*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.facebook.com/ads/library*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "exclude_matches": [
        "*://*.facebook.com/ads/library*"
      ],
      "js": [
        "feed-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "exclude_matches": [
        "*://*.facebook.com/ads/library*"
      ],
      "js": [
        "feed-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
